{
  "name": "basketline-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude test/e2e.kafka.test.ts --exclude test/flink.kafka.test.ts",
    "test:e2e": "vitest run test/e2e.kafka.test.ts",
    "test:flink": "vitest run test/flink.kafka.test.ts",
    "test:airflow": "uv run --with-requirements airflow/requirements.txt --with pytest==8.4.2 pytest -q airflow/tests --ignore airflow/tests/test_history_backfill.py",
    "test:backfill": "docker compose exec -T airflow sh -c '/opt/jobs/bin/pip install -q pytest==8.4.2 && cd /opt/airflow && /opt/jobs/bin/python -m pytest -q -p no:cacheprovider tests/test_history_backfill.py'",
    "check:architecture": "node scripts/check-architecture.ts",
    "keys": "node scripts/generate-keys.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm test",
    "db:generate": "pnpm -r --if-present db:generate",
    "seed": "node scripts/seed.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.1",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@basketline/contracts": "workspace:*",
    "@basketline/platform": "workspace:*",
    "@platformatic/kafka": "^2.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "1.88.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}

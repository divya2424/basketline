# Local run outside Docker (docker compose sets these for the container).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=
KAFKA_GROUP_ID=events-to-clickhouse
KAFKA_STARTING_OFFSETS=earliest
KAFKA_MAX_OFFSETS_PER_TRIGGER=200000
SPARK_TRIGGER_INTERVAL=30 seconds
SPARK_SHUFFLE_PARTITIONS=4
CHECKPOINT_LOCATION=./var/checkpoints/events-to-clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=ecommerce_analytics
CLICKHOUSE_PASSWORD=ecommerce_analytics_dev
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_TABLE=events
CLICKHOUSE_SECURE=false
CLICKHOUSE_INSERT_BATCH_SIZE=5000

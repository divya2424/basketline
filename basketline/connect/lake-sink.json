{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "2",
  "topics": "retail.interactions.v1,retail.identity-events.v1,retail.catalog-events.v1,retail.campaign-events.v1,retail.campaign-products.v1,auth.tenant.v1",
  "transforms": "flatten,kafka,kafkaTime",
  "transforms.flatten.type": "org.apache.kafka.connect.transforms.Flatten$Value",
  "transforms.flatten.delimiter": "_",
  "transforms.kafka.type": "org.apache.iceberg.connect.transforms.KafkaMetadataTransform",
  "transforms.kafkaTime.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.kafkaTime.field": "_kafka_metadata_timestamp",
  "transforms.kafkaTime.target.type": "Timestamp",

  "iceberg.catalog": "lake",
  "iceberg.catalog.catalog-impl": "org.apache.iceberg.jdbc.JdbcCatalog",
  "iceberg.catalog.uri": "${env:LAKE_CATALOG_URI}",
  "iceberg.catalog.jdbc.user": "${env:LAKE_CATALOG_USER}",
  "iceberg.catalog.jdbc.password": "${env:LAKE_CATALOG_PASSWORD}",
  "iceberg.catalog.warehouse": "s3://basketline-pipeline",
  "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
  "iceberg.catalog.s3.endpoint": "${env:LAKE_S3_ENDPOINT}",
  "iceberg.catalog.s3.path-style-access": "true",
  "iceberg.catalog.s3.access-key-id": "${env:LAKE_S3_ACCESS_KEY_ID}",
  "iceberg.catalog.s3.secret-access-key": "${env:LAKE_S3_SECRET_ACCESS_KEY}",
  "iceberg.catalog.client.region": "us-east-1",

  "iceberg.tables": "lake.interactions,lake.identity_events,lake.catalog_events,lake.campaign_events,lake.campaign_products,lake.tenants",
  "iceberg.tables.route-field": "_kafka_metadata_topic",
  "iceberg.table.lake.interactions.route-regex": "retail\\.interactions\\.v1",
  "iceberg.table.lake.identity_events.route-regex": "retail\\.identity-events\\.v1",
  "iceberg.table.lake.catalog_events.route-regex": "retail\\.catalog-events\\.v1",
  "iceberg.table.lake.campaign_events.route-regex": "retail\\.campaign-events\\.v1",
  "iceberg.table.lake.campaign_products.route-regex": "retail\\.campaign-products\\.v1",
  "iceberg.table.lake.tenants.route-regex": "auth\\.tenant\\.v1",
  "iceberg.tables.auto-create-enabled": "true",
  "iceberg.tables.evolve-schema-enabled": "true",
  "iceberg.tables.schema-force-optional": "true",
  "iceberg.tables.default-partition-by": "payload_tenantId,hour(_kafka_metadata_timestamp)",
  "iceberg.control.topic": "lake-sink.control",
  "iceberg.control.commit.interval-ms": "3600000"
}

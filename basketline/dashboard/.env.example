# The API gateway (run it with `docker compose up` in ..).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# "live" reads campaign metrics from the analytics API. "mock" shows clearly
# labelled demo numbers instead (no backend needed for the dashboard).
VITE_ANALYTICS_MODE=live

# The tenant selected until one is opened from the tenant list (a UUID). Sent as
# the `tenant_id` header on every API request.
VITE_TENANT_ID=5e0f3c2a-8b14-4d6f-9a27-1c3e5b7d9f01

# The retailer's storefront (../../retailer-sim/storefront), for each tenant's "Open store".
VITE_STOREFRONT_URL=http://localhost:5174

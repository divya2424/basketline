<!--
  Tiered storage for the raw tables (01_tables.sql): their newest days on local
  disk, older ones on S3, by each table's TTL ... TO VOLUME 'cold'. Locally S3 is
  archive-storage (SeaweedFS), under its own prefix; on AWS, a bucket of its own,
  with CLICKHOUSE_COLD_S3_USE_ENV_CREDENTIALS=true for the instance's IAM role.
  Mounted into /etc/clickhouse-server/config.d/ (docker-compose.yml).
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <cold>
                <type>s3</type>
                <endpoint from_env="CLICKHOUSE_COLD_S3_ENDPOINT"/>
                <access_key_id from_env="CLICKHOUSE_COLD_S3_ACCESS_KEY_ID"/>
                <secret_access_key from_env="CLICKHOUSE_COLD_S3_SECRET_ACCESS_KEY"/>
                <use_environment_credentials from_env="CLICKHOUSE_COLD_S3_USE_ENV_CREDENTIALS"/>
                <!-- Start even when S3 is unreachable (CI runs without it); only moves need it. -->
                <skip_access_check>true</skip_access_check>
            </cold>
        </disks>
        <policies>
            <tiered>
                <volumes>
                    <!-- Named "default", like the built-in policy's only volume: an
                         existing table can switch only to a policy that keeps it. -->
                    <default><disk>default</disk></default>
                    <cold><disk>cold</disk></cold>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>

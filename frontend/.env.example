# The API gateway (run the backend with `docker compose up` in ../backend).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# "live" reads campaign metrics from the analytics API. "mock" shows clearly
# labelled demo numbers instead (no backend needed for the dashboard).
VITE_ANALYTICS_MODE=live

# Tenant this storefront belongs to (a UUID). Sent as the `tenant_id` header on
# every API request: new accounts and visitor tokens belong to this tenant.
VITE_TENANT_ID=5e0f3c2a-8b14-4d6f-9a27-1c3e5b7d9f01

# Basketline's API (its gateway), for the Basketline SDK only: the storefront's
# events. Run the platform with `docker compose up` in ../../basketline.
VITE_BASKETLINE_API_URL=http://localhost:8080/api/v1

# The marketplace this app opens on until one is visited from the Marketplaces
# page. Sent as the `tenant_id` header.
VITE_TENANT_ID=5e0f3c2a-8b14-4d6f-9a27-1c3e5b7d9f01

# Basketline's API gateway (run it with `docker compose up` in ../../basketline).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Tenant this storefront belongs to (a UUID) until the Basketline dashboard's
# "Open store" names another. Sent as the `tenant_id` header on every API request.
VITE_TENANT_ID=5e0f3c2a-8b14-4d6f-9a27-1c3e5b7d9f01

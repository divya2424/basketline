{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-hooks",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/set-state-in-effect": "off",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  }
}
